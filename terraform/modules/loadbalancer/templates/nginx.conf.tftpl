upstream web_backend {
    zone web_backend 64k;
%{ if algorithm == "least_conn" ~}
    least_conn;
%{ endif ~}
%{ for b in backends ~}
    server ${b}:5000 max_fails=3 fail_timeout=10s;
%{ endfor ~}
}

server {
    listen 80;

    # Tamaño máximo del cuerpo de una petición (subida de imágenes)
    client_max_body_size ${max_upload_mb}m;
    
    # Endpoint propio del balanceador, para su healthcheck
    location = /lb-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://web_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Failover rápido: si una instancia no responde, prueba otra
        proxy_connect_timeout 2s;
        proxy_next_upstream error timeout;
    }
}
